# .env.example
# ---------------------------------------------------------------------------
# DHAP-34 — Email Event Extraction Pipeline  |  Environment Variables
# ---------------------------------------------------------------------------
# This file contains PLACEHOLDER values only.
# Copy it to .env and fill in real values before running docker compose up.
#
#   cp .env.example .env
#
# NEVER commit a populated .env to version control.
# The .gitignore already excludes .env.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Airflow
# ---------------------------------------------------------------------------

# The UID that Airflow processes run as inside the container.
# On Linux, set this to your host user's UID to avoid volume permission issues:
#   echo "AIRFLOW_UID=$(id -u)" >> .env
# On Windows/macOS with Docker Desktop, the default 50000 usually works.
AIRFLOW_UID=50000

# A random secret key for Airflow's web server session signing.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_WEBSERVER_SECRET_KEY=replace_with_a_random_hex_string

# ---------------------------------------------------------------------------
# PostgreSQL (shared credentials for BOTH postgres-meta and postgres-target)
# ---------------------------------------------------------------------------

# Database superuser username
POSTGRES_USER=airflow

# Database superuser password — use a strong password in production
POSTGRES_PASSWORD=replace_with_a_strong_password

# ---------------------------------------------------------------------------
# Target (warehouse) database — the DB the DAG loads data INTO.
# Do NOT point these at the Airflow metadata DB.
# ---------------------------------------------------------------------------

# Hostname of the postgres-target service as seen from inside Docker Compose.
# Must match the service name in docker-compose.yaml.
TARGET_DB_HOST=postgres-target

# Name of the warehouse database
TARGET_DB_NAME=mailex_warehouse

# Port inside the container (5432).
# The host port is 5433 (see docker-compose.yaml ports mapping).
TARGET_DB_PORT=5432
