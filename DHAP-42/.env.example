# .env.example
# ---------------------------------------------------------------------------
# DHAP-42 — CSV → MinIO Parquet Pipeline  |  Environment Variables
# ---------------------------------------------------------------------------
# Copy to .env and fill in real values before running docker compose up.
#
#   cp .env.example .env
#
# NEVER commit a populated .env to version control.
# The .gitignore already excludes .env.
#
# PORT NOTE — Avoiding conflicts with DHAP-34:
#   DHAP-34 uses: Airflow :8080, Postgres :5433 (host)
#   DHAP-42 uses: Airflow :8082, MinIO API :9020, MinIO console :9021
#   If you run both stacks simultaneously, there will be NO port collisions.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Airflow
# ---------------------------------------------------------------------------

# UID that Airflow processes run as inside the container.
# On Linux: echo "AIRFLOW_UID=$(id -u)" >> .env
# On Windows/macOS with Docker Desktop, leave as 50000.
AIRFLOW_UID=50000

# Random secret key for Airflow web-server session signing.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_WEBSERVER_SECRET_KEY=replace_with_a_random_hex_string

# Airflow admin credentials (created by airflow-init on first run)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------------
# PostgreSQL — Airflow metadata database (internal only)
# ---------------------------------------------------------------------------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=replace_with_a_strong_password

# ---------------------------------------------------------------------------
# MinIO
# ---------------------------------------------------------------------------

# Root (admin) credentials for MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Name of the bucket the DAG will write to (created by mc-init on startup)
MINIO_BUCKET=mailex-parquet

# ---------------------------------------------------------------------------
# Airflow → MinIO S3 connection
# Injected as an environment variable — no UI clicking required.
# Format: aws://<key>:<secret>@/?endpoint_url=http%3A%2F%2Fminio%3A9000
#
# The endpoint_url uses the Docker-internal service name 'minio' on port 9000
# (the MinIO API port inside the compose network, NOT the host-mapped port).
# URL-encode colons as %3A and slashes as %2F.
# ---------------------------------------------------------------------------
AIRFLOW_CONN_MINIO_S3=aws://minioadmin:minioadmin123@/?endpoint_url=http%3A%2F%2Fminio%3A9000

# ---------------------------------------------------------------------------
# Host port mappings (change if these clash with something on your machine)
# ---------------------------------------------------------------------------
# Airflow web UI  → http://localhost:8082
AIRFLOW_WEBSERVER_PORT=8082

# MinIO API       → http://localhost:9020  (used by boto3 / mc from the host)
MINIO_API_PORT=9020

# MinIO console   → http://localhost:9021
MINIO_CONSOLE_PORT=9021
